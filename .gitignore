# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Telos v2 — version-controlled identity + behavior for the single LEARN group.
# soul.md (identity), CLAUDE.local.md (operating contract), the two tick prompts,
# and memory-seed/ (templates the agent copies into memory/ on first run) are
# tracked. memory/ itself is agent-owned runtime state on mini and is NOT tracked;
# container.json stays per-installation (agent_group_id, host paths).
!groups/telos-learn/
groups/telos-learn/*
!groups/telos-learn/soul.md
!groups/telos-learn/CLAUDE.local.md
!groups/telos-learn/tick-realtime-prompt.md
!groups/telos-learn/tick-lesson-prompt.md
!groups/telos-learn/container.example.json
!groups/telos-learn/memory-seed/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
